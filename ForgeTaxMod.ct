  jz kt_hoi_to

  mov rcx, rdi
  xor edx, edx
  mov rax, ham_cd
  call rax
  mov r13d, eax

  mov dword ptr [rsp+20], 0FFFFFFFF
  mov qword ptr [rsp+28], 0
  mov qword ptr [rsp+30], 0
  mov qword ptr [rsp+38], 0
  mov qword ptr [rsp+40], 0
  mov qword ptr [rsp+48], 0
  mov rcx, rbx
  mov edx, r13d
  mov r8, [rdi+1F0]
  mov r9, [rdi+2B0]
  mov rax, ham_tr
  call rax

  mov dword ptr [rbx+50], 0

  mov rcx, rdi
  xor edx, edx
  mov rax, ham_wb
  call rax
  mov r14, rax
  test r14, r14
  jz kt_hoi_to

  mov rcx, r14
  mov rdx, rbx
  xor r8d, r8d
  mov rax, ham_hf
  call rax

  mov rcx, rbx
  mov rdx, r14
  mov r8, [rdi+2B0]
  xor r9d, r9d
  mov rax, ham_th
