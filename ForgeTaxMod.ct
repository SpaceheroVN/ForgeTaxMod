  pb_muc_vi.OnMouseEnter = function()
    muc_hover_popup = 1
    pcall(function() pb_muc_vi.repaint() end)
  end
  pb_muc_vi.OnMouseLeave = function()
    if muc_hover_popup == 1 then
      muc_hover_popup = 0
      pcall(function() pb_muc_vi.repaint() end)
    end
  end
  pb_muc_en.OnMouseEnter = function()
    muc_hover_popup = 2
    pcall(function() pb_muc_en.repaint() end)
  end
  pb_muc_en.OnMouseLeave = function()
    if muc_hover_popup == 2 then
      muc_hover_popup = 0
      pcall(function() pb_muc_en.repaint() end)
    end
  end
end)

-- Cập nhật chữ khi đổi ngôn ngữ
local function ap_dung_ngon_ngu_ui()
  cua_so.Caption = lay_chu("tieu_de")
  pcall(function() pb_tieu_de.repaint() end)
  pcall(function() pb_ngon_ngu.repaint() end)
  pcall(function() pb_ket_noi_lai.repaint() end)
  for ten_k, pb in pairs(danh_sach_ve_ct) do
    pcall(function() pb.repaint() end)
  end
  for chi_so, pb in ipairs(danh_sach_pb_f58) do
    pcall(function() pb.repaint() end)
  end
  pcall(function() pb_tien_nen.repaint() end)
  pcall(function() pb_nhan.repaint() end)
  if popup_nn_mo then
    pcall(function() pb_muc_vi.repaint(); pb_muc_en.repaint() end)
  end
end

pb_muc_vi.OnClick = function()
  ngon_ngu_hien_tai = "vi"
  dong_popup_nn()
  ap_dung_ngon_ngu_ui()
end

pb_muc_en.OnClick = function()
  ngon_ngu_hien_tai = "en"
  dong_popup_nn()
  ap_dung_ngon_ngu_ui()
end

-- Đăng ký phím tắt F1..F8 toàn cục
local danh_sach_hk = {
  { VK_F1 or 0x70, function() chuyen_doi_tinh_nang("khong_pha_huy") end, nil },
  { VK_F2 or 0x71, function() chuyen_doi_tinh_nang("khong_hu_ton") end, nil },
  { VK_F3 or 0x72, function() chuyen_doi_tinh_nang("khong_tinh_tien") end, nil },
  { VK_F4 or 0x73, function() chuyen_doi_tinh_nang("mien_cong_nap") end, nil },
  { VK_F5 or 0x74, function() kich_hoat_trieu_hoi(nil) end, nil },
  { VK_F6 or 0x75, function() kich_hoat_hoi_to(nil) end, nil },
  { VK_F7 or 0x76, function()
      kich_hoat_nang_cap(3, nil)
      phim_giu_f78 = 3
      moc_bat_dau_giu_phim = getTickCount()
      if dong_ho_giu then dong_ho_giu.Enabled = true end
    end, function()
      if phim_giu_f78 == 3 then phim_giu_f78 = 0 end
    end },
  { VK_F8 or 0x77, function()
      kich_hoat_nang_cap(4, nil)
      phim_giu_f78 = 4
      moc_bat_dau_giu_phim = getTickCount()
      if dong_ho_giu then dong_ho_giu.Enabled = true end
    end, function()
      if phim_giu_f78 == 4 then phim_giu_f78 = 0 end
    end }
}
for chi_so, d in ipairs(danh_sach_hk) do
  local ok_hk, hk_obj = pcall(createHotkeyEx, function() pcall(d[2]) end, d[3] and function() pcall(d[3]) end or nil, d[1])
  if ok_hk and hk_obj then
    table.insert(bo_phim_tat_mod, hk_obj)
  end
end

-- Bộ đếm lặp F7/F8 khi đang giữ phím/chuột
dong_ho_giu = createTimer(cua_so, false)
dong_ho_giu_mod = dong_ho_giu
dong_ho_giu.Interval = 80
dong_ho_giu.OnTimer = function(tm)
  if dang_thoat then
    tm.Enabled = false
    return
  end
  local bay_gio = getTickCount()
  if phim_giu_f78 ~= 0 then
    local vk = (phim_giu_f78 == 4) and (VK_F8 or 0x77) or (VK_F7 or 0x76)
    if isKeyPressed and (not isKeyPressed(vk)) then
      phim_giu_f78 = 0
    elseif (bay_gio - moc_bat_dau_giu_phim) &gt;= 240 then
      pcall(kich_hoat_nang_cap, phim_giu_f78, nil)
    end
  end
  if nut_giu_chuot_f78 ~= 0 then
    if isKeyPressed and (not isKeyPressed(0x01)) then
      nut_giu_chuot_f78 = 0
    elseif (bay_gio - moc_bat_dau_giu_nut) &gt;= 240 then
      pcall(kich_hoat_nang_cap, nut_giu_chuot_f78, nil)
    end
  end
  if phim_giu_f78 == 0 and nut_giu_chuot_f78 == 0 then
    tm.Enabled = false
  end
end
dong_ho_giu.Enabled = false

local dong_ho_an_ce = nil

-- Bộ đếm nền cập nhật kết nối và ẩn CE
local dong_ho = createTimer(cua_so, false)
dong_ho_mod = dong_ho
dong_ho.Interval = 500
dong_ho.OnTimer = function()
  if dang_thoat then return end
  pcall(function()
    local mf = getMainForm()
    if mf and mf.Visible then mf.hide() end
  end)
  pcall(thu_tu_dong_gan)
  local pid = getOpenedProcessID()
  local m = danh_sach_dia_chi.getMemoryRecordByID(1)
  local pid_moi, mau_p, man_moi, mau_m

  if not pid or pid == 0 or pid_cuoi == 0 then
    pid_moi = lay_chu("chua_ket_noi")
    mau_p = mau_vang_chinh
    man_moi = lay_chu("mo_tro_choi")
    mau_m = mau_chu_phu
    for k, pb in pairs(danh_sach_ve_ct) do
      if bo_nho_cong_tac[k] then
        bo_nho_cong_tac[k] = false
        pcall(function() pb.repaint() end)
      end
    end
  elseif m and m.Active then
    pid_moi = string.format(lay_chu("da_ket_noi"), pid)
    mau_p = mau_xanh_ket_noi
    for k, cfg in pairs(ban_do_cong_tac) do
      local st = ((readInteger(cfg.ky_hieu) or 0) ~= 0)
      if bo_nho_cong_tac[k] ~= st then
        bo_nho_cong_tac[k] = st
        if danh_sach_ve_ct[k] then pcall(function() danh_sach_ve_ct[k].repaint() end) end
        local r = danh_sach_dia_chi.getMemoryRecordByID(cfg.id)
        if r and r.Active ~= st then
          dang_dong_bo_muc = true
          r.Active = st
          dang_dong_bo_muc = false
        end
      end
    end

    local ok, thong_tin = kiem_tra_man_choi()
    if ok then
      local phong = thong_tin
      local sw = readQword(phong + 0x3B0) or 0
      if sw == 0 then sw = readQword(phong + 0x398) or 0 end
      local chuoi_cap = (sw ~= 0) and ("+" .. tostring(readInteger(sw + 0x50) or 0)) or "--"
      local cd = readQword(phong + 0xF0) or 0
      local vang = (cd ~= 0) and (readDouble(cd + 0x128) or 0) or 0
      local cred = (cd ~= 0) and (readInteger(cd + 0x10C) or 0) or 0
      man_moi = string.format(lay_chu("thong_so"), chuoi_cap, dinh_dang_so(vang), dinh_dang_so(cred))
      mau_m = mau_chu
    else
      man_moi = lay_chu(tostring(thong_tin))
      mau_m = (thong_tin == "vao_man_choi") and mau_vang_chinh or mau_chu_phu
    end
  else
    pid_moi = lay_chu("chua_ket_noi")
    mau_p = mau_vang_chinh
    man_moi = lay_chu("dang_tai")
    mau_m = mau_chu_phu
  end

  if pid_moi ~= chu_pid_hien_tai or mau_p ~= mau_pid_hien_tai or man_moi ~= chu_man_hien_tai or mau_m ~= mau_man_hien_tai then
    chu_pid_hien_tai = pid_moi
    mau_pid_hien_tai = mau_p
    chu_man_hien_tai = man_moi
    mau_man_hien_tai = mau_m
    pcall(function() pb_tieu_de.repaint() end)
  end
end
dong_ho.Enabled = true

-- Thoát an toàn qua bộ đếm một lần gốc CE
local function xu_ly_thoat_an_toan()
  if dang_thoat then return false end
  dang_thoat = true
  cua_so.OnCloseQuery = nil
  cua_so.OnClose = nil
  pcall(function() cua_so.hide() end)
  pcall(function() dong_ho.Enabled = false end)
  pcall(function() dong_ho_giu.Enabled = false end)
  if dong_ho_an_ce then pcall(function() dong_ho_an_ce.Enabled = false end) end
  for chi_so, hk in ipairs(bo_phim_tat_mod) do
    pcall(function() hk.destroy() end)
  end
  bo_phim_tat_mod = {}

  local m = danh_sach_dia_chi.getMemoryRecordByID(1)
  local pid = getProcessIDFromProcessName("ForgeTax.exe")
  if m and m.Active and pid and pid ~= 0 and pid == pid_cuoi then
    for k, cfg in pairs(ban_do_cong_tac) do
      pcall(ap_dung_cong_tac_vao_ram, k, false)
    end
    createTimer(80, function()
      pcall(function()
        if m.Active then m.Active = false end
      end)
      createTimer(40, function()
        pcall(closeCE)
      end)
    end)
  else
    pcall(dat_lai_muc_khong_ghi)
    createTimer(40, function()
      pcall(closeCE)
    end)
  end
  return false
end

cua_so.OnCloseQuery = function()
  return xu_ly_thoat_an_toan()
end

cua_so.OnClose = function()
  xu_ly_thoat_an_toan()
end

-- Theo dõi 3 giây đầu giữ ẩn cửa sổ CE
local dem_an_ce = 0
dong_ho_an_ce = createTimer(cua_so, false)
dong_ho_an_ce_mod = dong_ho_an_ce
dong_ho_an_ce.Interval = 50
dong_ho_an_ce.OnTimer = function(tm)
  dem_an_ce = dem_an_ce + 1
  if not dang_thoat then
    pcall(function()
      local mf = getMainForm()
      if mf and mf.Visible then mf.hide() end
    end)
  end
  if dang_thoat or dem_an_ce &gt;= 60 then
    tm.Enabled = false
  end
end
dong_ho_an_ce.Enabled = true

-- Hiện form và ẩn cửa sổ CE phía sau
pcall(thu_tu_dong_gan)
cua_so.show()
pcall(function() getMainForm().hide() end)
</LuaScript>
</CheatTable>
