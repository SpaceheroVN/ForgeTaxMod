-- Định dạng số (chấm dưới 1E6, E từ 1E6)
local function dinh_dang_so(gia_tri)
  if type(gia_tri) ~= "number" or gia_tri ~= gia_tri then return "0" end
  local am = gia_tri &lt; 0
  local td = math.abs(gia_tri)
  if td &lt; 0.5 then return "0" end
  if td &lt; 999999.5 then
    local s = tostring(math.floor(td + 0.5))
    local kq = s:reverse():gsub("(%d%d%d)", "%1."):reverse():gsub("^%.", "")
    return am and ("-" .. kq) or kq
  end
  local mu = math.floor(math.log(td) / math.log(10))
  local co_so = math.floor((td / (10 ^ mu)) * 100 + 0.5) / 100
  if co_so &gt;= 10 then
    co_so = 1
    mu = mu + 1
  end
  local str_co_so = string.format("%.2f", co_so):gsub("%.?0+$", "")
  return (am and "-" or "") .. str_co_so .. "E" .. tostring(mu)
end

-- Phân tích số (1E20, 100.000, 100,000)
local function phan_tich_so(tho)
  if not tho then return 0 end
  local s = tostring(tho):gsub("[%s_]", "")
  if s == "" then return 0 end
  local v = nil
  if s:match("[eE]") then
    v = tonumber((s:gsub(",", ".")))
  elseif s:match("^%d%d?%d?(%.%d%d%d)+$") or s:match("^%d%d?%d?(,%d%d%d)+$") then
    v = tonumber((s:gsub("[.,]", "")))
  else
    v = tonumber((s:gsub(",", ".")))
  end
  if not v or v ~= v or v &lt; 0 or v &gt; 1e300 or v == math.huge then
    return nil
  end
  return v
end

-- --- Bộ dựng ảnh 24-bit SDF chống răng cưa ---
local function kep(x, a, b)
  if x &lt; a then return a end
  if x &gt; b then return b end
  return x
end

local function tron_rgb(a, b, t)
  local k = kep(t, 0, 1)
  return a[1] + (b[1] - a[1]) * k, a[2] + (b[2] - a[2]) * k, a[3] + (b[3] - a[3]) * k
end

local function ghi_u32_le(dem, n, val)
  dem[n + 1] = val % 256
  dem[n + 2] = math.floor(val / 256) % 256
  dem[n + 3] = math.floor(val / 65536) % 256
  dem[n + 4] = math.floor(val / 16777216) % 256
end

local function khoang_cach_hop(px, py, cx, cy, hw, hh, r)
  local dx = math.abs(px - cx) - hw + r
  local dy = math.abs(py - cy) - hh + r
  local mx = dx &gt; 0 and dx or 0
  local my = dy &gt; 0 and dy or 0
  local trong = dx &gt; dy and dx or dy
  if trong &gt; 0 then trong = 0 end
  return math.sqrt(mx * mx + my * my) + trong - r
end

local function khoang_cach_doan(px, py, x1, y1, x2, y2)
  local vx = x2 - x1
  local vy = y2 - y1
  local len2 = vx * vx + vy * vy
  if len2 &lt;= 0.0001 then
    return math.sqrt((px - x1) * (px - x1) + (py - y1) * (py - y1))
  end
  local t = kep(((px - x1) * vx + (py - y1) * vy) / len2, 0, 1)
  local gx = x1 + vx * t - px
  local gy = y1 + vy * t - py
  return math.sqrt(gx * gx + gy * gy)
end

-- Tạo TBitmap 24-bit bottom-up chuẩn BMP
local function tao_bmp_24(w, h, ham_mau)
  local stride = math.floor((w * 3 + 3) / 4) * 4
  local kich_thuoc_anh = stride * h
  local tong = 54 + kich_thuoc_anh
  local dem = {}
  for i = 1, 54 do dem[i] = 0 end
  dem[1] = 66
  dem[2] = 77
  ghi_u32_le(dem, 2, tong)
  ghi_u32_le(dem, 10, 54)
  ghi_u32_le(dem, 14, 40)
  ghi_u32_le(dem, 18, w)
  ghi_u32_le(dem, 22, h)
  dem[27] = 1
  dem[29] = 24
  ghi_u32_le(dem, 34, kich_thuoc_anh)

  local idx = 55
  local pad = stride - w * 3
  for py = h - 1, 0, -1 do
    for px = 0, w - 1 do
      local r, g, b = ham_mau(px + 0.5, py + 0.5)
      dem[idx] = math.floor(kep(b + 0.5, 0, 255))
      dem[idx + 1] = math.floor(kep(g + 0.5, 0, 255))
      dem[idx + 2] = math.floor(kep(r + 0.5, 0, 255))
      idx = idx + 3
    end
    for p = 1, pad do
      dem[idx] = 0
      idx = idx + 1
    end
  end

  local ms = createMemoryStream()
  ms.write(dem)
  ms.Position = 0
  local bmp = createBitmap(w, h)
  bmp.loadFromStream(ms)
  ms.destroy()
  table.insert(danh_sach_bmp, bmp)
  return bmp
end

-- Dựng ảnh khung bo tròn chống răng cưa
local function tao_bmp_khung(w, h, r, nen_ngoai, nen_trong, vien)
  local cx = w * 0.5
  local cy = h * 0.5
  local hw = cx - 0.8
  local hh = cy - 0.8
  local tr, tg, tb = nen_trong[1], nen_trong[2], nen_trong[3]
  return tao_bmp_24(w, h, function(px, py)
    if px &gt;= r + 2 and px &lt;= w - r - 2 and py &gt;= r + 2 and py &lt;= h - r - 2 then
      return tr, tg, tb
    end
    local d = khoang_cach_hop(px, py, cx, cy, hw, hh, r)
    local cov_ngoai = kep(0.5 - d, 0, 1)
    local cov_trong = kep(-0.5 - d, 0, 1)
    local mr, mg, mb = tron_rgb(vien, nen_trong, cov_trong)
    return tron_rgb(nen_ngoai, {mr, mg, mb}, cov_ngoai)
  end)
end

-- Dựng ảnh công tắc 52x26 mượt
local function tao_bmp_cong_tac(bat, nen_ngoai)
  local w = 52
  local h = 26
  local cx = w * 0.5
  local cy = h * 0.5
  local x_num = bat and 39.0 or 13.0
  local y_num = 13.0
  local r_num = 9.0
  return tao_bmp_24(w, h, function(px, py)
    local d_ranh = khoang_cach_hop(px, py, cx, cy, cx - 1.0, cy - 1.0, 12.0)
    local cov_ranh = kep(0.5 - d_ranh, 0, 1)
    local cov_trong = kep(-0.5 - d_ranh, 0, 1)
    local rr, rg, rb
    local vr, vg, vb
    if bat then
      rr, rg, rb = tron_rgb(rgb_gat_dau, rgb_gat_cuoi, px / w)
      vr, vg, vb = rgb_gat_dau[1], rgb_gat_dau[2], rgb_gat_dau[3]
    else
      rr, rg, rb = rgb_gat_tat[1], rgb_gat_tat[2], rgb_gat_tat[3]
      vr, vg, vb = rgb_vien_gat_tat[1], rgb_vien_gat_tat[2], rgb_vien_gat_tat[3]
    end
    local mr, mg, mb = tron_rgb({vr, vg, vb}, {rr, rg, rb}, cov_trong)
    local cr, cg, cb = tron_rgb(nen_ngoai, {mr, mg, mb}, cov_ranh)

    local d_bong = math.sqrt((px - x_num) * (px - x_num) + (py - (y_num + 1.3)) * (py - (y_num + 1.3))) - (r_num + 0.6)
    local cov_bong = kep(1.0 - d_bong, 0, 1) * 0.34
    cr, cg, cb = tron_rgb({cr, cg, cb}, {0, 0, 0}, cov_bong)

    local d_num = math.sqrt((px - x_num) * (px - x_num) + (py - y_num) * (py - y_num)) - r_num
    local cov_num = kep(0.5 - d_num, 0, 1)
    if cov_num &gt; 0 then
      local nr, ng, nb
      if bat then
        nr, ng, nb = rgb_num_bat[1], rgb_num_bat[2], rgb_num_bat[3]
      else
        nr, ng, nb = rgb_num_tat[1], rgb_num_tat[2], rgb_num_tat[3]
      end
      cr, cg, cb = tron_rgb({cr, cg, cb}, {nr, ng, nb}, cov_num)
    end
    return cr, cg, cb
  end)
end

-- Dựng ảnh nút ngôn ngữ 114x26 kèm mũi tên
local function tao_bmp_nut_ngon_ngu(dang_mo, dang_hover, nen_ngoai)
  local w = 114
  local h = 26
  local cx = w * 0.5
  local cy = h * 0.5
  local nen = dang_hover and rgb_nut_nn_hover or rgb_nhap
  local vien = dang_mo and rgb_gat_dau or (dang_hover and rgb_vien_nn_hover or rgb_vien_nn)
  local mau_mt = (dang_mo or dang_hover) and rgb_vang_chinh or {148, 163, 184}
  local mx = w - 15.0
  local my = h * 0.5

  return tao_bmp_24(w, h, function(px, py)
    local d = khoang_cach_hop(px, py, cx, cy, cx - 0.8, cy - 0.8, 7.0)
    local cov_ngoai = kep(0.5 - d, 0, 1)
    local cov_trong = kep(-0.5 - d, 0, 1)
    local mr, mg, mb = tron_rgb(vien, nen, cov_trong)
    local cr, cg, cb = tron_rgb(nen_ngoai, {mr, mg, mb}, cov_ngoai)

    if px &gt;= mx - 6 and px &lt;= mx + 6 then
      local d1, d2
      if dang_mo then
        d1 = khoang_cach_doan(px, py, mx - 4.0, my + 2.0, mx, my - 2.2)
        d2 = khoang_cach_doan(px, py, mx, my - 2.2, mx + 4.0, my + 2.0)
      else
        d1 = khoang_cach_doan(px, py, mx - 4.0, my - 2.0, mx, my + 2.2)
        d2 = khoang_cach_doan(px, py, mx, my + 2.2, mx + 4.0, my - 2.0)
      end
      local d_mt = (d1 &lt; d2 and d1 or d2) - 0.85
      local cov_mt = kep(0.5 - d_mt, 0, 1)
      if cov_mt &gt; 0 then
        cr, cg, cb = tron_rgb({cr, cg, cb}, mau_mt, cov_mt)
      end
    end
    return cr, cg, cb
  end)
end

-- Dựng chấm tròn 10x10 báo mục đang chọn
local function tao_bmp_cham_chon(nen_ngoai)
  return tao_bmp_24(10, 10, function(px, py)
    local d = math.sqrt((px - 5.0) * (px - 5.0) + (py - 5.0) * (py - 5.0)) - 3.0
    local cov = kep(0.5 - d, 0, 1)
    return tron_rgb(nen_ngoai, rgb_gat_dau, cov)
  end)
end

