o_ham_zh:
  dq aob_zh_sau-0E
o_tra_cap_nhat:
  dq aob_cap_nhat_sau
o_tra_cc:
  dq aob_cc_truoc+25
o_tra_zh:
  dq aob_zh_sau
o_tra_af:
  dq aob_af_sau
o_tra_gf:
  dq aob_gf_sau
o_tra_zh_vo:
  dq aob_zh_vo
