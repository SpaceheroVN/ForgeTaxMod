  xor r9d, r9d
  mov rax, ham_ur
  call rax

  mov rcx, [rdi+3C8]
  test rcx, rcx
  jz sp_bo_qua_ds
  inc dword ptr [rcx+1C]
  mov rdx, [rcx+10]
  test rdx, rdx
  jz sp_ds_cham
  movsxd r8, dword ptr [rcx+18]
  cmp r8d, [rdx+18]
  jae sp_ds_cham
  lea eax, [r8+1]
  mov [rcx+18], eax
  mov [rdx+r8*8+20], rbx
  lea rcx, [rdx+r8*8+20]
  mov rdx, rbx
  mov rax, ham_rao_ghi
  call rax
  jmp sp_bo_qua_ds

sp_ds_cham:
  mov r9, [o_mi_ds_goc]
  mov rax, [r9]
  test rax, rax
  jnz sp_ds_mi_ok
  mov rcx, r9
