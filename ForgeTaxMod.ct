local function ve_muc_popup(s, ma, ten)
  if dang_thoat then return end
  local cv = s.Canvas
  local chon = (ngon_ngu_hien_tai == ma)
  local re = (muc_hover_popup == (ma == "vi" and 1 or 2))
  local mau_nen_m = mau_popup
  if re then
    cv.draw(0, 0, bmp_muc_hover)
    mau_nen_m = mau_hover_popup
  elseif chon then
    cv.draw(0, 0, bmp_muc_chon)
    mau_nen_m = mau_chon_popup
  else
    cv.Brush.Color = mau_popup
    cv.Pen.Color = mau_popup
    cv.fillRect(0, 0, s.Width, s.Height)
  end
  if chon then
    cv.draw(6, 10, re and bmp_cham_hover or bmp_cham_chon)
  end
  local mau_chu_m = chon and mau_vang_hover or (re and mau_rgb(255, 255, 255) or mau_chu)
  ve_chu(cv, 20, 0, 82, 30, ten, mau_chu_m, 9, chon, "left", mau_nen_m)
end

pb_muc_vi.OnPaint = function(s) ve_muc_popup(s, "vi", "Tiếng Việt") end
pb_muc_en.OnPaint = function(s) ve_muc_popup(s, "en", "English") end

