local bmp_cham_hover    = tao_bmp_cham_chon(rgb_hover_popup)

-- Hủy toàn bộ ký hiệu AA đã đăng ký
local function huy_tat_ca_ky_hieu()
  for chi_so, sym in ipairs(tat_ca_ky_hieu) do
    pcall(unregisterSymbol, sym)
  end
end

-- Đặt lại mục CE và xóa bộ đệm khi tắt game
function dat_lai_muc_khong_ghi()
  bo_qua_ghi_tat = true
  dang_dong_bo_muc = true
  bo_dem_dc = {}
  for id = 2, 9 do
    local r = danh_sach_dia_chi.getMemoryRecordByID(id)
    if r and r.Active then
      pcall(function() r.disableWithoutExecute() end)
    end
  end
  local m = danh_sach_dia_chi.getMemoryRecordByID(1)
  if m and m.Active then
    pcall(function() m.disableWithoutExecute() end)
  end
  huy_tat_ca_ky_hieu()
  dang_dong_bo_muc = false
  bo_qua_ghi_tat = false
end

-- Nạp sẵn địa chỉ cờ v4 tránh tra cứu lặp
local function nap_bo_dem_dc()
  for k, cfg in pairs(ban_do_cong_tac) do
    local dc = getAddressSafe(cfg.ky_hieu)
    if dc and dc ~= 0 then bo_dem_dc[k] = dc end
  end
  local dc_hud = getAddressSafe("co_lam_moi_hud")
  if dc_hud and dc_hud ~= 0 then bo_dem_dc.co_lam_moi_hud = dc_hud end
end

-- Kiểm tra game đang ở trong màn chơi
function kiem_tra_man_choi()
  local ok, phong = pcall(readQword, "phong_ren")
  if not ok or not phong or phong == 0 then
    return false, "vao_man_choi"
  end
  local dang_title = readBytes(phong + 0x490, 1)
  if dang_title and dang_title ~= 0 then
    return false, "vao_man_choi"
  end
  local cd = readQword(phong + 0xF0) or 0
  local ds = readQword(phong + 0x3C8) or 0
  if cd == 0 or ds == 0 then
    return false, "dang_tai"
  end
  return true, phong
end

-- Tự tắt nút một lần sau 100ms
local function tu_tat_muc_mot_lan(rec_id)
  if not rec_id then return end
  createTimer(100, function()
    if dang_thoat then return end
    local r = danh_sach_dia_chi.getMemoryRecordByID(rec_id)
    if r and r.Active then
      dang_dong_bo_muc = true
      r.Active = false
      dang_dong_bo_muc = false
    end
  end)
end

-- Tự gắn ForgeTax.exe và bật ForgeTax Mod
function dam_bao_moc_chinh()
  local pid = getProcessIDFromProcessName("ForgeTax.exe")
  if not pid or pid == 0 then return false end
  if getOpenedProcessID() ~= pid or pid ~= pid_cuoi then
    if pid_cuoi ~= 0 and pid ~= pid_cuoi then
      dat_lai_muc_khong_ghi()
    end
    openProcess(pid)
    pid_cuoi = pid
    pid_da_moc = 0
  end
  local ga = getAddressSafe("GameAssembly.dll")
  if not ga or ga == 0 then
    pcall(reinitializeSymbolhandler, true)
    ga = getAddressSafe("GameAssembly.dll")
  end
  if not ga or ga == 0 then return false end
  local m = danh_sach_dia_chi.getMemoryRecordByID(1)
  if not m then return false end
  if m.Active then
    pid_da_moc = pid
    nap_bo_dem_dc()
    return true
  end
  local ok = pcall(function() m.Active = true end)
  if not ok or not m.Active then return false end
  pid_da_moc = pid
  nap_bo_dem_dc()
  return true
end

-- Ghi 4 byte công tắc xuống vùng RWX
local function ap_dung_cong_tac_vao_ram(khoa, bat)
  local cfg = ban_do_cong_tac[khoa]
  if not cfg then return false end
  local dc = bo_dem_dc[khoa]
  if not dc or dc == 0 then
    dc = getAddressSafe(cfg.ky_hieu)
    if dc and dc ~= 0 then bo_dem_dc[khoa] = dc end
  end
  if not dc or dc == 0 then return false end
  writeInteger(dc, bat and 1 or 0)

  local dc_hud = bo_dem_dc.co_lam_moi_hud
  if not dc_hud or dc_hud == 0 then
    dc_hud = getAddressSafe("co_lam_moi_hud")
    if dc_hud and dc_hud ~= 0 then bo_dem_dc.co_lam_moi_hud = dc_hud end
  end
  if dc_hud and dc_hud ~= 0 then
    writeInteger(dc_hud, 1)
  end
  bo_nho_cong_tac[khoa] = bat
  if danh_sach_ve_ct[khoa] then
    pcall(function() danh_sach_ve_ct[khoa].repaint() end)
  end
  return true
end

-- Đồng bộ khi bấm CheatEntry F1..F4
function dat_muc_cong_tac(khoa, bat, rec_id)
  if dang_dong_bo_muc or bo_qua_ghi_tat then return end
  if bat then
    if not dam_bao_moc_chinh() then
      tu_tat_muc_mot_lan(rec_id)
      return
    end
  else
    local pid = getProcessIDFromProcessName("ForgeTax.exe")
    if not pid or pid == 0 or pid ~= pid_cuoi then return end
  end
  ap_dung_cong_tac_vao_ram(khoa, bat)
end

-- Đảo công tắc F1..F4 tức thì bằng bộ đệm
function chuyen_doi_tinh_nang(khoa)
  if dang_thoat then return end
  if pid_da_moc == 0 or not bo_dem_dc[khoa] then
    if not dam_bao_moc_chinh() then return end
  end
  local cfg = ban_do_cong_tac[khoa]
  if not cfg then return end
  local moi = not (bo_nho_cong_tac[khoa] and true or false)
  if not ap_dung_cong_tac_vao_ram(khoa, moi) then
    bo_dem_dc[khoa] = nil
    if dam_bao_moc_chinh() then
      ap_dung_cong_tac_vao_ram(khoa, moi)
    end
  end
end

-- Tắt hết mục con khi tắt mục gốc
function tat_toan_bo_muc_con()
  local pid = getProcessIDFromProcessName("ForgeTax.exe")
  local da_tat = (not pid or pid == 0 or (pid_cuoi ~= 0 and pid ~= pid_cuoi))
  if da_tat then bo_qua_ghi_tat = true end
  for id = 2, 9 do
    local r = danh_sach_dia_chi.getMemoryRecordByID(id)
    if r and r.Active then
      if da_tat then
        pcall(function() r.disableWithoutExecute() end)
      else
        r.Active = false
      end
    end
  end
  bo_qua_ghi_tat = false
end

-- Kích hoạt F5 triệu hồi kiếm +0
function kich_hoat_trieu_hoi(rec_id)
  if dang_thoat or not dam_bao_moc_chinh() then
    tu_tat_muc_mot_lan(rec_id)
    return
  end
  local ok = kiem_tra_man_choi()
  if not ok then
    tu_tat_muc_mot_lan(rec_id)
    return
  end
  local cur = readInteger("so_kiem_trieu_hoi") or 0
  writeInteger("so_kiem_trieu_hoi", cur + 1)
  pcall(beep)
  tu_tat_muc_mot_lan(rec_id)
end

-- Kích hoạt F6 hồi tố thời gian
function kich_hoat_hoi_to(rec_id)
  if dang_thoat or not dam_bao_moc_chinh() then
    tu_tat_muc_mot_lan(rec_id)
    return
  end
  local ok = kiem_tra_man_choi()
  if not ok then
    tu_tat_muc_mot_lan(rec_id)
    return
  end
  writeInteger("co_hoi_to", 1)
  pcall(beep)
  tu_tat_muc_mot_lan(rec_id)
end

-- Kích hoạt F7 (+1) hoặc F8 (+2)
function kich_hoat_nang_cap(ket_qua, rec_id)
  if dang_thoat or not dam_bao_moc_chinh() then
    tu_tat_muc_mot_lan(rec_id)
    return
  end
  local ok = kiem_tra_man_choi()
  if not ok then
    tu_tat_muc_mot_lan(rec_id)
    return
  end
  writeInteger("ket_qua_nang_cap", ket_qua)
  tu_tat_muc_mot_lan(rec_id)
end

-- Tặng Vàng và Credits hỗ trợ dạng E
function kich_hoat_tang_tien(chuoi_vang, chuoi_credits)
  local v = phan_tich_so(chuoi_vang)
  local c = phan_tich_so(chuoi_credits)
  if v == nil or c == nil or (v == 0 and c == 0) then return end
  if not dam_bao_moc_chinh() then return end
  local ok = kiem_tra_man_choi()
  if not ok then return end
  local c_an_toan = math.min(math.floor(c + 0.5), 2000000000)
  writeDouble("them_vang", v)
  writeInteger("them_credits", c_an_toan)
  writeInteger("co_tang_tien", 1)
  pcall(beep)
end

-- Tự gắn ForgeTax.exe nền không dùng sleep
local function thu_tu_dong_gan()
  if dang_thoat then return end
  local pid = getProcessIDFromProcessName("ForgeTax.exe")
  if not pid or pid == 0 then
    if pid_cuoi ~= 0 then
      dat_lai_muc_khong_ghi()
      pid_cuoi = 0
      pid_da_moc = 0
    end
    return
  end
  if pid ~= pid_cuoi or getOpenedProcessID() ~= pid then
    dat_lai_muc_khong_ghi()
    openProcess(pid)
    pid_cuoi = pid
    pid_da_moc = 0
  end
  if pid_da_moc ~= pid then
    local ga = getAddressSafe("GameAssembly.dll")
    if not ga or ga == 0 then
      pcall(reinitializeSymbolhandler, true)
      ga = getAddressSafe("GameAssembly.dll")
    end
    if ga and ga ~= 0 then
      local m = danh_sach_dia_chi.getMemoryRecordByID(1)
      if m then
        if not m.Active then
          local ok = pcall(function() m.Active = true end)
          if ok and m.Active then
            pid_da_moc = pid
            nap_bo_dem_dc()
          end
        else
          pid_da_moc = pid
          nap_bo_dem_dc()
        end
      end
    end
  end
end

