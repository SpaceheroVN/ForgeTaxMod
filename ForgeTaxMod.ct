local bmp_khung_tien    = tao_bmp_khung(440, 74, 10, rgb_nen, rgb_the, rgb_vien_the)
local bmp_o_nhap        = tao_bmp_khung(158, 30, 7, rgb_the, rgb_nhap, rgb_vien_nhap)

local bmp_nn_dong       = tao_bmp_nut_ngon_ngu(false, false, rgb_the)
local bmp_nn_mo         = tao_bmp_nut_ngon_ngu(true, false, rgb_the)
local bmp_khung_popup   = tao_bmp_khung(114, 68, 8, rgb_nen, rgb_popup, rgb_vien_popup)
local bmp_muc_chon      = tao_bmp_khung(106, 30, 5, rgb_popup, rgb_chon_popup, rgb_chon_popup)
