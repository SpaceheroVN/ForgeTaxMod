sp_ds_mi_ok:
  mov rax, [rax+20]
  mov r8, [rax+0A8]
  mov r8, [r8+70]
  mov rcx, [rdi+3C8]
  mov rdx, rbx
  mov rax, [o_ham_ds_lon]
