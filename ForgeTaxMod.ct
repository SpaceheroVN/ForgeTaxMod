  dq aob_lf_mua
o_tra_lf_mua_thieu:
  dq aob_lf_mua+2A
o_tra_lf_tru1:
  dq aob_lf_tru1
o_tra_lf_tru2:
  dq aob_lf_tru2
o_tra_yf_mua_ok:
  dq aob_yf_mua+51D
o_tra_yf_mua_thieu:
  dq aob_yf_mua
o_tra_zf_tru:
  dq aob_zf_tru
o_tra_ui_thuong_nhan:
  dq aob_ui_thuong_nhan
o_tra_ui_co_vat:
  dq aob_ui_co_vat

ham_tra_nua:
  movsd xmm0, [hang_so_nua]
  ret

doan_cc_cuoi:
  movups xmm0, [rax]
  mov eax, [rax+10]
  movups [rsi], xmm0
  mov [rsi+10], eax
  cmp dword ptr [khong_pha_huy], 0
  je cc_kt_hu_ton
  mov ecx, [rsi]
  test ecx, ecx
  jz cc_kt_hu_ton
  add [rsi+08], ecx
  mov dword ptr [rsi], 0
cc_kt_hu_ton:
  cmp dword ptr [khong_hu_ton], 0
  je cc_xong
  mov ecx, [rsi+04]
  test ecx, ecx
  jz cc_xong
  add [rsi+08], ecx
  mov dword ptr [rsi+04], 0
cc_xong:
  mov rax, rsi
  jmp qword ptr [o_tra_cc]

doan_zh_dau:
  test edx, edx
  jnz zh_kt_hu_ton
  cmp dword ptr [khong_pha_huy], 0
  je zh_goc
  mov edx, 2
  jmp zh_goc
zh_kt_hu_ton:
  cmp edx, 1
  jne zh_goc
  cmp dword ptr [khong_hu_ton], 0
  je zh_goc
  mov edx, 2
zh_goc:
  mov rax, rsp
  mov [rax+20], r9
  mov [rax+18], r8
  mov [rax+10], edx
  jmp qword ptr [o_tra_zh]

doan_af_dau:
  cmp dword ptr [khong_tinh_tien], 0
  je af_goc
  mov al, 1
  ret
af_goc:
  push rbx
  sub rsp, 30
  mov rbx, rcx
  mov rax, [o_co_af_goc]
  test rax, rax
  jnz af_san_sang
  mov rax, aob_af_sau
  movsxd rdx, dword ptr [rax+28]
  lea rax, [rax+rdx+2D]
  mov [o_co_af_goc], rax
af_san_sang:
  cmp byte ptr [rax], 0
  jmp qword ptr [o_tra_af]

doan_gf_dau:
  cmp dword ptr [mien_cong_nap], 0
  je gf_goc
  xorps xmm0, xmm0
  ret
gf_goc:
  push rbx
  sub rsp, 80
  mov rax, [o_co_gf_goc]
  test rax, rax
  jnz gf_san_sang
  mov rax, aob_gf_sau
  movsxd rdx, dword ptr [rax+5F]
  lea rax, [rax+rdx+64]
  mov [o_co_gf_goc], rax
gf_san_sang:
  cmp byte ptr [rax], 0
  jmp qword ptr [o_tra_gf]

// Hook F1 chống vỡ kiếm trong khối vỡ
doan_zh_vo:
  db 8B 85 58 01 00 00
  cmp dword ptr [khong_pha_huy], 0
  jne zh_vo_khong_gay
  db 41 C6 47 69 01
  jmp zh_vo_xong
zh_vo_khong_gay:
  db 41 C6 47 69 00
zh_vo_xong:
  db 41 89 47 54 41 89 4F 5C
  jmp qword ptr [o_tra_zh_vo]

// Hook F3 mua cổ vật miễn phí (Credits)
doan_lf_mua:
  cmp dword ptr [khong_tinh_tien], 0
  jne lf_mua_duoc
  db 66 0F 6E 8E 0C 01 00 00 F2 0F 10 40 18 F3 0F E6 C9 66 0F 2F C1
  ja lf_mua_thieu
lf_mua_duoc:
  jmp qword ptr [o_tra_lf_mua_ok]
lf_mua_thieu:
  jmp qword ptr [o_tra_lf_mua_thieu]

doan_lf_tru1:
  cmp dword ptr [khong_tinh_tien], 0
  jne lf_tru1_xong
  db F2 0F 2C 40 18 29 86 0C 01 00 00
lf_tru1_xong:
  db 48 8B 45 18
  jmp qword ptr [o_tra_lf_tru1]

doan_lf_tru2:
  cmp dword ptr [khong_tinh_tien], 0
  jne lf_tru2_xong
  db F2 0F 2C 40 18 29 86 0C 01 00 00
lf_tru2_xong:
  db 48 8B 45 18
  jmp qword ptr [o_tra_lf_tru2]

// Hook F3 mua thương nhân miễn phí (Gold)
doan_yf_mua:
  cmp dword ptr [khong_tinh_tien], 0
  jne yf_mua_duoc
  db F2 0F 10 46 18 66 0F 2F 85 28 01 00 00
  jbe yf_mua_duoc
  jmp qword ptr [o_tra_yf_mua_thieu]
yf_mua_duoc:
  jmp qword ptr [o_tra_yf_mua_ok]

doan_zf_tru:
  db F2 0F 10 85 28 01 00 00 33 D2
  cmp dword ptr [khong_tinh_tien], 0
  jne zf_tru_xong
  db F2 0F 5C 47 18
zf_tru_xong:
  db 48 8B CF F2 0F 11 85 28 01 00 00
  jmp qword ptr [o_tra_zf_tru]

// Hook UI luôn hiện đủ tiền mua khi bật F3
doan_ui_thuong_nhan:
  db 41 B6 01
  cmp dword ptr [khong_tinh_tien], 0
  je ui_tn_goc
  mov eax, 1
  jmp qword ptr [o_tra_ui_thuong_nhan]
ui_tn_goc:
  db F2 0F 10 80 28 01 00 00 66 0F 2F 46 18 0F 93 C0
  jmp qword ptr [o_tra_ui_thuong_nhan]

doan_ui_co_vat:
  cmp dword ptr [khong_tinh_tien], 0
  je ui_cv_goc
  mov eax, 1
  jmp qword ptr [o_tra_ui_co_vat]
ui_cv_goc:
  db 66 0F 6E F6 45 33 C0 48 8B D3 48 8B C8 F3 0F E6 F6
  mov rax, ham_gia_co_vat
  call rax
  db 33 C0 66 0F 2F F0 0F 93 C0
  jmp qword ptr [o_tra_ui_co_vat]

doan_cap_nhat:
  mov [phong_ren], rcx
  inc dword ptr [nhip_khung_hinh]

  cmp qword ptr [o_ham_tao], 0
  jne khoi_tao_o_xong
  mov r8, aob_tao_kiem
  movsxd rax, dword ptr [r8+3]
  lea rax, [r8+rax+7]
  mov [o_mi_tao], rax
  movsxd rax, dword ptr [r8+15]
  lea rax, [r8+rax+19]
  mov [o_ham_tao], rax

  mov r8, aob_ds_kiem
  movsxd rax, dword ptr [r8+13]
  lea rax, [r8+rax+17]
  mov [o_mi_ds_goc], rax
  movsxd rax, dword ptr [r8+44]
  lea rax, [r8+rax+48]
  mov [o_ham_ds_lon], rax

  mov r8, aob_m_uy_quyen
  movsxd rax, dword ptr [r8+3]
  lea rax, [r8+rax+7]
  mov [o_lop_m_uy_quyen], rax

khoi_tao_o_xong:
  test rcx, rcx
  jz thoat_goc
  mov rax, [rcx+0F0]
  mov [chien_dich], rax
  cmp byte ptr [rcx+490], 0
  jne thoat_goc
  cmp dword ptr [khoa_ban], 0
  jne thoat_goc

  mov eax, [so_kiem_trieu_hoi]
  or eax, [co_hoi_to]
  or eax, [ket_qua_nang_cap]
  or eax, [co_tang_tien]
  or eax, [co_lam_moi_hud]
  jz thoat_goc

  mov dword ptr [khoa_ban], 1
  push rbx
  push rsi
  push rdi
  push rbp
  push r12
  push r13
  push r14
  push r15
  sub rsp, 88
  mov rdi, rcx

  cmp qword ptr [rdi+0F0], 0
  jz ket_thuc_viec
  cmp qword ptr [rdi+2B0], 0
  jz ket_thuc_viec
  cmp qword ptr [rdi+330], 0
  jz ket_thuc_viec
  cmp qword ptr [rdi+3C8], 0
  jz ket_thuc_viec

  // F5: Triệu hồi 1 kiếm +0 trước mặt
  cmp dword ptr [so_kiem_trieu_hoi], 0
  jle kt_hoi_to
  lock dec dword ptr [so_kiem_trieu_hoi]

  mov rdx, [rdi+338]
  test rdx, rdx
  jnz sp_co_tr
  mov rdx, [rdi+340]
  test rdx, rdx
  jz sp_toa_do_fb
sp_co_tr:
  lea rcx, [rsp+50]
  xor r8d, r8d
  mov rax, ham_lay_vi_tri
  call rax
  jmp sp_dat_xoay

sp_toa_do_fb:
  mov dword ptr [rsp+50], 3E2E147B
  mov dword ptr [rsp+54], 3F933333
  mov dword ptr [rsp+58], 3E6147AE

sp_dat_xoay:
  xor eax, eax
  mov [rsp+60], eax
  mov [rsp+64], eax
  mov [rsp+68], eax
  mov dword ptr [rsp+6C], 3F800000

  mov rcx, [o_mi_tao]
  mov r9, [rcx]
  test r9, r9
  jnz sp_mi_ok
  mov rax, ham_khoi_tao_meta
  call rax
  mov rcx, [o_mi_tao]
  mov r9, [rcx]
