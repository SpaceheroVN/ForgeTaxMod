-- Vẽ chữ ClearType căn chỉnh trên Canvas
local function ve_chu(cv, x, y, w, h, noi_dung, mau, co, dam, can_le, mau_nen_chu)
  cv.Font.Name = "Segoe UI"
  cv.Font.Size = co or 10
  cv.Font.Style = dam and "[fsBold]" or "[]"
  cv.Font.Color = mau or mau_chu
  pcall(function() cv.Font.Quality = "fqCleartype" end)
  cv.Brush.Color = mau_nen_chu or mau_the
  pcall(function() cv.Brush.Style = "bsClear" end)
  local tw = cv.getTextWidth(noi_dung)
  local th = cv.getTextHeight(noi_dung)
  local tx = x
  if can_le == "center" then
    tx = x + math.floor((w - tw) * 0.5)
  elseif can_le == "right" then
    tx = x + w - tw
  end
  local ty = y + math.floor((h - th) * 0.5)
  cv.textOut(tx, ty, noi_dung)
end

